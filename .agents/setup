#!/usr/bin/env bash
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
for tool in python3 curl tar jq sudo; do
  command -v "$tool" >/dev/null || { echo "Missing orb bootstrap prerequisite: $tool" >&2; exit 1; }
done
printf 'Installing/verifying pinned build and security tools...\n'
time ./tools/install.sh

# Export to future non-interactive login shells, not just this setup process.
marker="# sovereign-stack orb environment: $root"
if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<EOF

$marker
if [[ "\$PWD" == "$root" || "\$PWD" == "$root/"* ]]; then
  case ":\$PATH:" in
    *":$root/.tools/bin:"*) ;;
    *) export PATH="$root/.tools/bin:\$PATH" ;;
  esac
  # Nested orb Docker has no NAT bridge; this is not a deployment setting.
  export BUILD_NETWORK=host SMOKE_NETWORK=host
fi
EOF
fi
printf 'Orb toolchain ready. Pinned application dependencies build inside Docker, not on the host.\n'
